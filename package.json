{
  "name": "ottery-live",
  "version": "0.1.5",
  "description": "Multi-platform live streaming desktop app",
  "author": {
    "name": "Zor",
    "email": "zor@zortechlabs.com"
  },
  "homepage": "https://ottermade.space/otterylive",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:frontend\" \"npm:dev:overlays\" \"npm:dev:server\" \"npm:dev:electron\"",
    "dev:frontend": "cd frontend && ng serve --port 4200",
    "dev:overlays": "cd overlays && ng serve --port 4201",
    "dev:server": "cross-env OTTERY_DEV=true nodemon server/index.js",
    "dev:electron": "cross-env OTTERY_DEV=true wait-on http://localhost:4200 http://localhost:3737/api/health && electron .",
    "server": "node server/index.js",
    "build:frontend": "cd frontend && npx ng build",
    "build:overlays": "cd overlays && npx ng build",
    "build": "npm run build:frontend && npm run build:overlays",
    "electron:rebuild": "node scripts/rebuild-native.js",
    "node:rebuild": "npm rebuild better-sqlite3",
    "verify:native": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/verify-native.js",
    "postinstall": "npm install --prefix overlays --ignore-scripts",
    "test:server": "jest --testPathPattern=server/",
    "test:frontend": "cd frontend && ng test",
    "test:frontend:ci": "cd frontend && npx ng test --watch=false",
    "test:e2e": "playwright test",
    "package:win": "npm run build && npm run electron:rebuild && npm run verify:native && electron-builder --win",
    "package:mac": "npm run build && npm run electron:rebuild && npm run verify:native && electron-builder --mac",
    "package:linux": "npm run build && npm run electron:rebuild && npm run verify:native && electron-builder --linux",
    "package:all": "npm run build && npm run electron:rebuild && npm run verify:native && electron-builder --win --mac --linux",
    "generate-icons": "node scripts/generate-icons.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.0",
    "better-sqlite3": "^11.6.0",
    "bilibili-live-ws": "^4.3.0",
    "bonjour-service": "^1.2.1",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.0",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.2.0",
    "keytar": "^7.9.0",
    "knex": "^3.1.0",
    "node-media-server": "^4.2.4",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "tiktok-live-connector": "^2.1.1-beta1",
    "undici": "^8.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "png2icons": "^2.0.1",
    "supertest": "^7.2.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "tv.ottery.live",
    "productName": "Ottery Live",
    "npmRebuild": false,
    "copyright": "Copyright © 2026 Ottery Live",
    "directories": {
      "output": "dist/installers"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/frontend/**/*",
      "dist/overlays/**/*",
      "node_modules/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffmpeg-static/index.js",
      "node_modules/ffmpeg-static/package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "OtteryLive-Setup-${version}.exe",
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg"
      ]
    },
    "afterSign": "scripts/after-sign.js",
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "OtteryLive-${version}.dmg",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg.exe"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "zortech",
      "repo": "otterly-live"
    }
  }
}
